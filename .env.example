OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Langfuse tracing. Enabled only when LANGFUSE_ENABLED=1 and all three keys are set.
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local
LANGFUSE_TRACING_RELEASE=dev
LANGFUSE_SAMPLE_RATE=1.0
# Langfuse prompt label the app reads (staging for testing a new version).
LANGFUSE_PROMPT_LABEL=production
# Raw code/model content is never sent unless this is 1 AND the environment is local.
LANGFUSE_CAPTURE_CONTENT=0
LANGFUSE_SHOW_TRACE_LINK=0
